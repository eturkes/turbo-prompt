{
  "name": "turbo-prompt",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build && node scripts/emit-plugin-manifest.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "CHROMIUM_PATH=\"$(chromiumfish path)\" playwright test",
    "check": "vp check && vp test && vp build && node scripts/emit-plugin-manifest.mjs",
    "preview": "vp preview --host 0.0.0.0"
  },
  "dependencies": {
    "@in-progress/protocol": "file:vendor/in-progress-protocol",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
